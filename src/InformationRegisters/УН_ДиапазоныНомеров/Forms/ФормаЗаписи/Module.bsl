
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьФорму();
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьПрефиксПриИзменении(Элемент)
	ОбновитьФорму()
КонецПроцедуры


&НаКлиенте
Процедура АвтонумерацияПриИзменении(Элемент)
	ОбновитьФорму()
КонецПроцедуры



#Область СлужебныеПроцедурыИФункции
// Обновить форму 
&НаКлиенте
Процедура ОбновитьФорму()	
	// префикс
	Элементы.Префикс.Доступность = Запись.ИспользоватьПрефикс;
	Если НЕ Запись.ИспользоватьПрефикс Тогда
		Запись.Префикс = "";
	КонецЕсли;
	
	// диапазон номеров
	Элементы.НачальноеЗначение.Доступность = Запись.Автонумерация;
	Элементы.КонечноеЗначение.Доступность = Запись.Автонумерация;
	Если НЕ Запись.Автонумерация Тогда
		Запись.НачальноеЗначение = 0;
		Запись.КонечноеЗначение = 0;
	КонецЕсли;	
КонецПроцедуры 


