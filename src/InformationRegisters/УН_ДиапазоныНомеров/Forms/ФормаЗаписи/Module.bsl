КонецФункции

// Проверяет, что поле Префикс заполнено, если активна опция ИспользоватьПрефикс
Функция ПроверитьЗаполнениеПрефикс()
	Возврат Истина;
КонецФункции

// Проверяет, что Начальное и Конечное значения заполнены, если активна опция Автонумерация
Функция ПроверитьЗаполнениеНачальноеИКонечноеЗначение()
	Возврат Истина;
КонецФункции

// Проверка корректности настройки
Функция ПроверитьДиапазонНомеров()
	ПроверитьЗаполнениеНачальноеИКонечноеЗначение();
	ПроверитьЗначенияИнтервала();
	ПроверитьПересекающиесяДиапозыНомеров(); 
	ПроверитьЗаполнениеПрефикс(); 
КонецФункции

#КонецОбласти 
	
	

