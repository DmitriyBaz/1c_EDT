// Возвращает цвет в формате 1С (тип Цвет) по строке.
// Поддерживаются строки, содержащие описание цвета в шестнадцатеричном формате и в формате RGB
// Параметры:
//  * ЦветСтрока - Строка - Текстовая строка должна содержать значения компонентов цвета внутри скобок (), разделенных запятой.
// 		Пример: "rgb(0,225,10)" или "hsla(0, 100%, 50%, 0.5)". Функция ЦветПоСтроке(Знач ЦветСтрока)
//
// Возвращаемое значение:
//  Цвет в формате 1С. Если не удалось определить цвет, тогда возвращается черный цвет
Функция ЦветПоСтроке(Знач ЦветСтрока)
	ЧерныйЦвет = WebЦвета.Черный;	// цвет по умолчанию
	
	// цвет задан в шестнадцатеричном формате 
	Если СтрНачинаетсяС(ЦветСтрока,"#") Тогда
		Цвет = УН_ЦветСервисКлиентСервер.HEX_в_RGB(ЦветСтрока);
		Возврат Цвет;
	КонецЕсли;
	
	КомпонентыЦвета = ОпределитьКомпонентыЦвета(ЦветСтрока); 
	Если КомпонентыЦвета = Неопределено Тогда
		Цвет = ЧерныйЦвет;
		Возврат Цвет;
	КонецЕсли;		
	
	// цвет задан в RGB формате 	
	Если СтрНачинаетсяС(ВРег(ЦветСтрока),"RGB") Тогда
		Если КомпонентыЦвета.Количество() = 3 Тогда
			Цвет = Новый Цвет(
				КомпонентыЦвета[0],
				КомпонентыЦвета[1],
				КомпонентыЦвета[2]);
				
			// исключение для церного цвета
			Если КомпонентыЦвета[0] = 0
				И КомпонентыЦвета[1] = 0
				И КомпонентыЦвета[2] = 0 Тогда
				Цвет = ЧерныйЦвет;
			КонецЕсли;
		Иначе
			Цвет = ЧерныйЦвет;
		КонецЕсли;				
	КонецЕсли;
	
	// цвет задан в RGBА формате (RGBA — Red, Green, Blue, Alpha)
	Если СтрНачинаетсяС(ВРег(ЦветСтрока),"RGBA") Тогда
		// прозрачность не поддерживается
		Цвет = ЧерныйЦвет;	 			
	КонецЕсли;
	
	// цвет задан в HSL формате (Hue, Saturation, Lightness)
	Если СтрНачинаетсяС(ВРег(ЦветСтрока),"HSL") Тогда
		// прозрачность не поддерживается
		Цвет = ЧерныйЦвет;	 			
	КонецЕсли;	
	
	// цвет задан в HSLA формате (Hue, Saturation, Lightness, Alpha)
	Если СтрНачинаетсяС(ВРег(ЦветСтрока),"HSLA") Тогда
		// прозрачность не поддерживается
		Цвет = ЧерныйЦвет;	 			
	КонецЕсли;
	
	Возврат Цвет;	
КонецФункции
	
// Выделяет из строки текста компоненты цвета (без относительно в каком они формате).
// Параметры:
//  * ЦветСтрока - Строка - Текстовая строка должна содержать значения компонентов цвета внутри скобок (), разделенных запятой.
// 		Пример: "rgb(0,225,10)" или "hsla(0, 100%, 50%, 0.5)".  
// 
// Возвращаемое значение:
//  Массив - содержит значения, которые были в круглых скобках в той же последовательности, как они были указаны в исходной строке.
Функция ОпределитьКомпонентыЦвета(Знач ЦветСтрока)
	Результат = Неопределено;
	
	РегулярноеВыражение = "\(([^)]+)\)";
	РезультатПоиска = СтрНайтиПоРегулярномуВыражению(ЦветСтрока, 
		РегулярноеВыражение,
		НаправлениеПоиска.СНачала,,,Истина);
	
	Если РезультатПоиска.НачальнаяПозиция <> 0 Тогда
		Группы = РезультатПоиска.ПолучитьГруппы(); 
		СтрокаРезультата = Группы[0].Значение;
		Результат = СтрРазделить(СтрокаРезультата,",");
	КонецЕсли;
	
	Возврат Результат;	
КонецФункции

// Возвращает значение величины в поинтах
// Параметры:
//  * ЗначениеТекст	- Строка	- Соджержит значение свойства CSS и его единицу. Например: "12pt" или "110 %" и т.д. 
//  * РазмерШрифта 	- Число 	- Размер шрифта в pt. Значение по умолчанию = 12pt. Используется, если исходное значение задано в em или % (1em = текущий размер шрифта в pt)
//
// Возвращаемое значение:
//  Число - числовое значение величины в pt. Если исходную величину невозможно перевести в pt, тогда содержит 0.
//			Если параметр ЗначениеТекст не указан, то возвращает 0.
//
Функция ЗначениеВПоинтах(Знач ЗначениеТекст, Знач РазмерШрифта = 12)
	Результат = 0;
	
	Если НЕ ЗначениеЗаполнено(ЗначениеТекст) Тогда
		Возврат Результат;
	КонецЕсли;
	
	// значение
	РегулярноеВыражение = "-?\d+(?:\.\d+)?"; // Находит: 123, 123.45, -123.45	
	РезультатПоиска = СтрНайтиПоРегулярномуВыражению(ЗначениеТекст, 
		РегулярноеВыражение,
		НаправлениеПоиска.СНачала,,,Истина);
	
	Если РезультатПоиска.НачальнаяПозиция <> 0 Тогда
		Результат = Число(Сред(ЗначениеТекст, 
			РезультатПоиска.НачальнаяПозиция, 
			РезультатПоиска.Длина));
	Иначе
		Возврат Результат;
	КонецЕсли;
	
	// единицы
	РегулярноеВыражение = "\b(?:pt|px|em|rem|%|vh|vw|vmin|vmax|ex|ch|cm|mm|in|pc|q)\b"; // Находит: pt, px, em, rem, %, vh, vw, vmin, vmax)
	РезультатПоиска = СтрНайтиПоРегулярномуВыражению(ЗначениеТекст, 
		РегулярноеВыражение,
		НаправлениеПоиска.СНачала,,,Истина);
	
	Если РезультатПоиска.НачальнаяПозиция <> 0 Тогда				
		Единица = Сред(ЗначениеТекст,
			РезультатПоиска.НачальнаяПозиция + РезультатПоиска.Длина + 1, 
			РезультатПоиска.Длина);
	Иначе
		Единица = "pt";	// если не задано, то считаем, что размер в pt		
	КонецЕсли;
	
	Проценты 			= "%";
	ОтносительноШрифта 	= "em";
	Пиксели 			= "px";
	Поинты 				= "pt";
	
	Если ВРег(Единица) = ВРег(ОтносительноШрифта) Тогда
		Результат = Результат * РазмерШрифта;		
	КонецЕсли;
			
	Если ВРег(Единица) = Проценты Тогда
		// % и em не поддерживаются => нет отступа	
		Результат = Результат * РазмерШрифта / 100;
	КонецЕсли;
	
	Если ВРег(Единица) = ВРег(Пиксели) Тогда
		Результат = Окр(Результат * 72 / 96, 1); 
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ИнициализацияЭлементовСтиля()
	Шрифт		= Новый Шрифт();
	ЦветТекста 	= Новый Цвет();
	ЦветФона 	= Новый Цвет();	
	
	Параграф 	= Новый Структура();
	Параграф.Вставить("ГоризонтальноеПоложение");
	Параграф.Вставить("МеждустрочныйИнтервал");
	Параграф.Вставить("Отступ");
	Параграф.Вставить("ТипПараграфа");
	
	Результат 	= Новый Структура();
	Результат.Вставить("Параграф", Параграф);	
	Результат.Вставить("ЦветТекста", ЦветТекста); 
	Результат.Вставить("ЦветФона", ЦветФона);
	Результат.Вставить("Шрифт", Шрифт);
	
	// признаки
	Результат.Вставить("ЦветТекстаУстановлен", Ложь); 
	Результат.Вставить("ЦветФонаУстановлен", Ложь);
	
	Возврат Результат;
КонецФункции	

&НаКлиенте 
// Получает границы выделенного фрагмента текста и возвращает массив элементов.
// Возвращаемое значение: 
//  * Массив - может содержать элементы только следующих типов:
// 					ТекстФорматированногоДокумента, 
//					ПереводСтрокиФорматированногоДокумента 
// 					КартинкаФорматированногоДокумента.
Функция ВыделенныйФрагмент()
	НачальнаяПозиция = 0;
	КонечнаяПозиция = 0;
	Элементы.ДополнительныйТекстКСообщению.ПолучитьГраницыВыделения(НачальнаяПозиция,КонечнаяПозиция);
    Результат = ДополнительныйТекстКСообщению.СформироватьЭлементы(НачальнаяПозиция,КонечнаяПозиция);
	Возврат Результат; 
КонецФункции

