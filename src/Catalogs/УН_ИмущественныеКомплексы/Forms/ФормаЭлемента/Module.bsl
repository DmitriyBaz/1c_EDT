&НаСервере
Процедура ГруппаЗакладкиИзмеренияНаСервере()
    // Преобразуем реквизит Объект в прикладной объект  
	ОбъектФормы = РеквизитФормыВЗначение("Объект");
		
	АдресИзмеренийВоВременномХранилище = Потомки.НайтиПоЗначению("Измерения");
	
	Если АдресИзмеренийВоВременномХранилище = неопределено Тогда
		// создаем объект - менеджер измерений и используем его для получения данных
		ИК = УН_ИмущественныйКомплексФабрика.НайтиПоКлючу(
			ОбъектФормы.Код, 
			РежимОбъекта);
 
		МенеджерИзмерений = ИК.МенеджерИзмерений();
		ИзмеренияФормы = МенеджерИзмерений.ВсеИзмерения().Скопировать(); 
		
		АдресИзмеренийВоВременномХранилище = ПоместитьВоВременноеХранилище(ИзмеренияФормы,ЭтаФорма.УникальныйИдентификатор);
		Потомки.Добавить("Измерения",АдресИзмеренийВоВременномХранилище);
		
		ЗначениеВРеквизитФормы(ИзмеренияФормы, "Измерения");
	Иначе
		//// есть данные во временном хранилище  
		//Попытка
		//	ИзмеренияФормы = ПолучитьИзВременногоХранилища(АдресИзмеренийВоВременномХранилище);  
		//Исключение
		//	Сообщить(ИнформацияОбОшибке());
		//КонецПопытки;		
	КонецЕсли;
КонецПроцедуры


