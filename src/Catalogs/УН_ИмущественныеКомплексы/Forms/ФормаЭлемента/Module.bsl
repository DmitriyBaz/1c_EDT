&НаКлиенте
Процедура СоздатьПоОбразцу(Команда)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИсходнаяОрганизация",Объект.Организация);
	ПараметрыФормы.Вставить("ИсходныйКод",Объект.Код);
	ПараметрыФормы.Вставить("ИсходныйИдентификатор",Объект.Идентификатор);
	ПараметрыФормы.Вставить("ИсходноеНаименование",Объект.Наименование);
	
    ОткрытьФорму("ОбщаяФорма.УН_СозданиеПоОбразцу",ПараметрыФормы,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ДатаАктуальностиПриИзменении(Элемент)
	// заголовок
	ТекстОбъекта = ОбновитьЗаголовокНаСервере("Имущественный комплекс", Объект.Идентификатор, Объект.Наименование);
	
	Если ДатаАктуальности >= ТекущаяДата() Тогда
		// актуально
		ТекстАкутальности = "актуальные данные"; 
		Элементы.ГруппаСтатусыИМетки.ТолькоПросмотр = Ложь;
		Элементы.ГруппаЗакладки.ТолькоПросмотр = Ложь; 
		Элементы.Декорация1.Видимость = Ложь;  
		Элементы.Декорация2.Видимость = Истина;
		Элементы.ГруппаЗаголовок.ЦветФона = Новый Цвет(184,222,178); // стиль: цвет метки Зеленый
		
		
	Иначе
		// не актуально
		ТекстАкутальности = СтрШаблон("актуально на %1",Строка(ДатаАктуальности));
		Элементы.ГруппаСтатусыИМетки.ТолькоПросмотр = Истина;
		Элементы.ГруппаЗакладки.ТолькоПросмотр = Истина;
		Элементы.Декорация1.Видимость = Истина; 
		Элементы.Декорация2.Видимость = Ложь;

		Элементы.ГруппаЗаголовок.ЦветФона = Новый Цвет(194,200,209);	// стиль: цвет метки Серый	
		
	КонецЕсли;
		
	ЗаголовокОбъекта 	= СтрШаблон("%1 (%2)",ТекстОбъекта,ТекстАкутальности);

КонецПроцедуры

