// Форма

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если РежимОбъекта = ПредопределенноеЗначение("Перечисление.УН_РежимОбъекта.Просмотр") Тогда 
		ЭтаФорма.ТолькоПросмотр = Истина;
	КонецЕсли;  
	ДатаАктуальности = ТекущаяДата()+1;
	
	// заголовок
	ТекстОбъекта 		= ОбновитьЗаголовокНаСервере("Имущественный комплекс", Объект.Идентификатор, Объект.Наименование);
	Если ДатаАктуальности >= ТекущаяДата() Тогда
		ТекстАкутальности = "актуальная версия"; 		
	Иначе
		// не актуально
		ТекстАкутальности = СтрШаблон("актуально на %1",Строка(ДатаАктуальности));
		Элементы.ГруппаСтатусыИМетки.ТолькоПросмотр = Истина;
		Элементы.ГруппаЗакладки.ТолькоПросмотр = Истина;
		Элементы.Декорация1.Видимость = Истина; 
		Элементы.Декорация2.Видимость = Ложь;

		Элементы.ГруппаЗаголовок.ЦветФона = Новый Цвет(194,200,209);	// стиль: цвет метки Серый	
	КонецЕсли;
		
	ЗаголовокОбъекта 	= СтрШаблон("%1 (%2)",ТекстОбъекта,ТекстАкутальности);
	
	// остальные поля
	Адрес = "г. Москва, ул.Новая, д.1, к.1, Россия, 190001";
	АдресГород = "Москва";
	АдресУлица = "Новая ул.";
	АдресДом = "1";
	АдресКорп = "1";
	АдресИндекс = "190001";
	АдресСтрана = "RU";
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура Проверить(Команда)
	ЖурналСообщений = Новый Массив;
	ПроверитьНаСервере(ЖурналСообщений);
	
	// вывод результатов проверки
	Для каждого Сообщение из ЖурналСообщений Цикл 
		Сообщить(Сообщение);
	КонецЦикла;		
КонецПроцедуры

