&НаСервере
Процедура ПроверитьНаСервере(ЖурналСообщений)
	// Инициализация констант
	РежимСоздание = Перечисления.УН_РежимОбъекта.Создание;  
	РежимПросмотр = Перечисления.УН_РежимОбъекта.Просмотр;

	// Преобразовать реквизит Объект в прикладной объект  
	ОбъектФормы = РеквизитФормыВЗначение("Объект");  
	
	// Получить Объект 
	Если РежимОбъекта = РежимСоздание Тогда
		// новый объект
	    ИК = УН_ИмущественныйКомплексФабрика.Создать(
			ОбъектФормы.Организация,
			ОбъектФормы.ТипИмущественногоКомплекса);	
	Иначе		
		// существующий объект
		ИК = УН_ИмущественныйКомплексФабрика.НайтиПоКлючу(
			ОбъектФормы.Код, 
			РежимОбъекта);			
	КонецЕсли;
	
	Если РежимОбъекта <> РежимПросмотр Тогда			
		// зарегистрировать всех потомков
		ИК.ЗарегистрироватьВсехПотомков();
		
		// обновить данные в объекте и подчиненных объектах 
		Адрес = неопределено;
		ИК.ЗаполнитьИзВременногоХранилища(Объект, Адрес);  
	КонецЕсли;  
	
	ИК.ПроверитьВсе(ЖурналСообщений);	
КонецПроцедуры





