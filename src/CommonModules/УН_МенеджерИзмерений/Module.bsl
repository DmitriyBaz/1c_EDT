// Реализует конкретную функциональность записи объекта в базу (сохранения изменений)
Процедура ОбъектЗаписать(МенеджерИзмерений, ЖурналСообщений)
	// Заполним Идентификатор для всех записей
	Попытка
		ДополнительныеСвойства = МенеджерИзмерений.ДополнительныеСвойства;
		Родитель = ДополнительныеСвойства.Родитель;	
	Исключение
		// Обработка ошибок
		Сообщить("Невозможно получить Родителя для Менеджера измерений");  
		Возврат;
	КонецПопытки;
	
	Идентификатор = Родитель.ПолучитьИдентификатор();	
	
	Для каждого Запись из МенеджерИзмерений Цикл
		Запись.Идентификатор = Идентификатор;	
	КонецЦикла; 
	
	МенеджерИзмерений.Записать();	
КонецПроцедуры  

