// Начальная инициализация объекта
Процедура ИнициализироватьПоРодителю(МенеджерИзмерений, Родитель) Экспорт; 
    РежимСоздание = Перечисления.УН_РежимОбъекта.Создание;
	
	// Прочитать записи из базы
	Если Родитель.Режим() <> РежимСоздание Тогда
		МенеджерИзмерений.Отбор.Идентификатор.Установить(Родитель.Идентификатор());
		МенеджерИзмерений.Прочитать();
		
		// запомним считанные из базы значения
		МенеджерИзмерений.ДополнительныеСвойства.ДанныеДоИзменения = МенеджерИзмерений.Выгрузить();  
	КонецЕсли;
	
КонецПроцедуры
	
// Создает запись об измерении, добавляет ее в набор записей.
// Функция возвращает добавленную запись, если операция выполнена успешно или Неопределено.
// 
// Параметры:
// 	* Объект - менеджер измерений
//  * Запись - структура - запись об измерении:
// 		- Идентификатор - строка(22)	- бизнес-ключ объекта, к которому относится измерение;
//		- ВидИзмерения - справочник 	- вид измерения    
// 		- ДействуетС - дата 			- дата начала действия измерения
// 		- ДействуетПо - дата			- дата окончания действия измерения
// 		- Значение - число(17,4) 		- значение измерения
// 		- ЕдиницаИзмерения - справочник - единица измерения
Функция ДобавитьЗапись(МенеджерИзмерений, Запись) Экспорт; 
	Результат = Неопределено;
	
	Если МенеджерИзмерений = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	НоваяЗапись = МенеджерИзмерений.Добавить();
	НоваяЗапись.Идентификатор = Запись.Идентификатор;
	НоваяЗапись.ВидИзмерения = Запись.ВидИзмерения;
	НоваяЗапись.ДействуетС = Запись.ДействуетС;
	НоваяЗапись.ДействуетПо = Запись.ДействуетПо;
	НоваяЗапись.Значение = Запись.Значение;
	НоваяЗапись.ЕдиницаИзмерения = Запись.ЕдиницаИзмерения;
	
	Результат = НоваяЗапись;
	Возврат Результат;
КонецФункции

// Возвращает запись по ключу в формате структуры записи об измерении.
Функция ПолучитьЗапись(МенеджерИзмерений, ВидИзмерения, ДействуетС) Экспорт; 
	Результат = неопределено;
	Для каждого Запись из МенеджерИзмерений Цикл
		Если 	Запись.ВидИзмерения = ВидИзмерения
			И	Запись.ДействуетС = ДействуетС Тогда
			// нашли запись
			Результат = УН_МенеджерИзмеренийФабрика.СоздатьЗапись();
			
			Результат.Идентификатор		= Запись.Идентификатор;
			Результат.ВидИзмерения 		= Запись.ВидИзмерения; 
			Результат.ДействуетС 		= Запись.ДействуетС; 
			Результат.ДействуетПо 		= Запись.ДействуетПо; 
			Результат.Значение 			= Запись.Значение; 
			Результат.ЕдиницаИзмерения 	= Запись.ЕдиницаИзмерения;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Удаляет запись по ключу. Возвращает номер удаленной записи или -1, если запись для удаления не найдена.
Функция УдалитьЗапись(МенеджерИзмерений, ВидИзмерения, ДействуетС) Экспорт; 
	Результат = -1;
	Счетчик = -1;
	Для каждого Запись из МенеджерИзмерений Цикл
		Счетчик = Счетчик + 1;
		Если 	Запись.ВидИзмерения = ВидИзмерения
			И	Запись.ДействуетС 	= ДействуетС Тогда
			// нашли запись
			// удалить
			МенеджерИзмерений.Удалить(Счетчик);
			Результат = Счетчик;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

// Возвращает список всех записей в формате таблицы значений
Функция ВсеИзмерения(МенеджерИзмерений) Экспорт; 
	Возврат МенеджерИзмерений.Выгрузить();
КонецФункции

