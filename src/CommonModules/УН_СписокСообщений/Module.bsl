// Создает и возвращает таблицу значений для хранения списка сообщений Журнала сообщений
// Возвращаемое значение:
//  ТаблицаЗначений:
//		* КлючЖурналаСообщений 		- строка - уникальный идентификтаор Журнала сообщений
// 		* ВнутреннийНомерСообщения 	- число	 - порядковый номер сообщения в списке
//		* Родитель					- число  - порядковый номер сообщения, который является родителем тек.сообщения
// 		* ТипСообщения				- ПеречислениеСсылка.УН_ТипСообщения - тип сообщения: Ошибка, Предупреждение, Информация
// 		* КодПредметнойОбласти		- строка(50) - КодПредметнойОбласти значение кода элемента (СправочникСсылка.УН_ПредметныеОбласти)
//		* НомерСообщения			- строка(4) - код сообщения (СправочникСсылка.УН_ШаблоныСообщений.Код)
//		* ТекстСообщения			- строка(150) - текст шаблона сообщения
// 		* Параметр1					- строка(50) - значение Параметра 1
//		* Параметр2					- строка(50) - значение Параметра 2
// 		* Параметр3					- строка(50) - значение Параметра 3
// 		* Параметр4	      			- строка(50) - значение Параметра 4
// 		* Контекст					- структура - контекст сообщения:
// 			** ОбъектМетаданных		- строка
//			** ОбъектМетаданныхКлюч - строка
//			** ИмяРеквизита			- строка
// 			** ЗначениеРеквизита	- строка
//		* СообщениеСсылка			- СправочникСсылка.УН_ШаблоныСообщений - ссылка на шаблон сообщения
//		ЕстьДопТекст				- булево - признак наличия дополнительного текста 
//		ЕстьКонтекст				- булево - признак наличия контекста
//
Функция НовыйТаблицаСообщений() 
	Сообщения = Новый ТаблицаЗначений;
	УстановитьСтруктуруТаблицыСообщений(Сообщения);	
	Возврат Сообщения; 
КонецФункции


// Обновляет типы сообщений в иерархии на основе типа переданного сообщения.
// Если подчиненное сообщение имеет более критичный тип сообщения, чем тип сообщения Родителя, 
// то тип сообщения Родителя изменяется на тип подчиненного сообщения.
//
// Параметры:
//   СписокСообщений - Структура - см. НовыйСписокСообщений()
//   Сообщение - Структура - см. УН_СписокСообщенийКлиентСервер.НовыйСтруктураСообщения()
//
Процедура ОбновитьТипыСообщенийВИерархии(СписокСообщений, Знач Сообщение) 
	Если СписокСообщений.Сообщения.Количество() = 0 Тогда
		Возврат; 
	КонецЕсли;

	Сообщения = СписокСообщений.Сообщения;
	ТекущееСообщение = Сообщение;
	ВнутреннийНомерРодителя = Сообщение.Родитель;

	Пока Истина Цикл
		ВышестоящееСообщение = Сообщения.Найти(ВнутреннийНомерРодителя, "ВнутреннийНомерСообщения");
		Если ВышестоящееСообщение = Неопределено Тогда
			Прервать;
		КонецЕсли;

		ИндексТипаСообщенияРодителя = Перечисления.УН_ТипыСообщений.Индекс(ВышестоящееСообщение.ТипСообщения);
		ИндексТипаСообщенияТекущего = Перечисления.УН_ТипыСообщений.Индекс(ТекущееСообщение.ТипСообщения);	
		
		Если ИндексТипаСообщенияРодителя > ИндексТипаСообщенияТекущего Тогда 
			ВышестоящееСообщение.ТипСообщения = Сообщение.ТипСообщения; 
		КонецЕсли;
		
		ВнутреннийНомерРодителя = ВышестоящееСообщение.Родитель;
		ТекущееСообщение = ВышестоящееСообщение;
	КонецЦикла;
КонецПроцедуры


// Обновляет статистику сообщений в переданном списке сообщений.
//
// Параметры:
//   СписокСообщений - Структура - Список сообщений, см. НовыйСписокСообщений()
Процедура ОбновитьСтатистикуСообщений(СписокСообщений)
	ТипОшибка = Перечисления.УН_ТипыСообщений.Ошибка;
	ТипПредупреждение = Перечисления.УН_ТипыСообщений.Предупреждение;
	ТипИнформация = Перечисления.УН_ТипыСообщений.Информация;
	
	Ошибок 			= 0;
	Предупреждений 	= 0;
	Информация 		= 0; 
	Всего			= 0;
	
	Для каждого Сообщение из СписокСообщений.Сообщения Цикл
		Всего = Всего + 1;
		
		Если Сообщение.ТипСообщения = ТипОшибка Тогда
			Ошибок = Ошибок +1;
		ИначеЕсли Сообщение.ТипСообщения = ТипПредупреждение Тогда
			Предупреждений = Предупреждений + 1;
		ИначеЕсли Сообщение.ТипСообщения = ТипИнформация Тогда
			Информация = Информация + 1;
		Иначе
		КонецЕсли;		
	КонецЦикла;
			
	СписокСообщений.Заголовок.КоличествоОшибки 			= Ошибок;	
	СписокСообщений.Заголовок.КоличествоПредупреждения  = Предупреждений;
	СписокСообщений.Заголовок.КоличествоИнформация 		= Информация;
	СписокСообщений.Заголовок.КоличествоВсего			= Всего;
КонецПроцедуры


// Процедура вызывает исключение, если есть ошибки 
// Параметры:
//  СписокСообщений	- Структура - см.НовыйСписокСообщений()
Процедура ПроверитьСписокСообщений(СписокСообщений)
	// Проверка реквизита "Объект Журнала"
	Объект = СписокСообщений.Заголовок.ОбъектЖурнала; 
	Если Объект = неопределено Тогда
		УН_ИсключенияВызовСервера.ВызватьИсключениеЗначениеНеопределено("ОбъектЖурнала");		
	КонецЕсли;
КонецПроцедуры

// Возвращает номера картинки в коллекции картинок для значения перечислени УН_ТипыСообщений.
// Коллекция картинок содержит изображения в следующей последовательности: Ошибка, Предупреждение, Информация
// Параметры: 
//  ТипСообщения - ПеречислениеСсылка.УН_ТипыСообщений - значение перечисления
// 
// Возвращаемое значение:
//  Число - номер картинки в коллекции картинок. Возвращает значение -1, 
//					если не удалось значение перечисления.
Функция ИндексКартинкиДляТипаСообщения(Знач ТипСообщения)
	Ошибка 		   = Перечисления.УН_ТипыСообщений.Ошибка;
	Предупреждение = Перечисления.УН_ТипыСообщений.Предупреждение;
	Информация 	   = Перечисления.УН_ТипыСообщений.Информация;
	
	Результат  = -1;
	
	// ошибка
	Если ТипСообщения = Ошибка Тогда
		Результат = 0;
	КонецЕсли; 
	
	// предупреждение
	Если ТипСообщения = Предупреждение Тогда
		Результат = 1;
	КонецЕсли;

	// информация
	Если ТипСообщения = Информация Тогда
		Результат = 2;
	КонецЕсли;
	
	Возврат Результат;		
КонецФункции

Функция ЕстьКонтекст(Знач Контекст)
	// Проверка на пустое значение
	Если Контекст = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Может быть параметр представлен строкой => преобразуем к Структуре
	Если ТипЗнч(Контекст) = Тип("Строка") Тогда
		Попытка
			СтруктураКонтекст = ЗначениеИзСтрокиВнутр(Контекст);
		Исключение
			УН_ИсключенияВызовСервера.ВызватьИсключениеНедопустимыйТип("Контекст");
		КонецПопытки;
	Иначе
		СтруктураКонтекст = Контекст;
	КонецЕсли;
	
    // Может быть значение Неопределено => нет контекста
    Если СтруктураКонтекст = Неопределено Тогда
        Возврат Ложь;
    КонецЕсли;		
	
	// Если значение не является Структурой => ошибка
	Если ТипЗнч(СтруктураКонтекст) <> Тип("Структура") Тогда
		УН_ИсключенияВызовСервера.ВызватьИсключениеНедопустимыйТип("Контекст");
	КонецЕсли;
	
    // Проверка наличия заполненных значений в структуре
    Если СтруктураКонтекст.Количество() = 0 Тогда
        Возврат Ложь;
    КонецЕсли;	
	
	Для Каждого Элемент Из СтруктураКонтекст Цикл
		Если ЗначениеЗаполнено(Элемент.Значение) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
КонецФункции


#КонецОбласти
