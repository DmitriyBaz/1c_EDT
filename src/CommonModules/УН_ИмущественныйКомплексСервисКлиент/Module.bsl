// Создает новый объект Имущественный комплекс без сохранения и открывает форму объекта
//	Параметры:
//	 ОсновныеДанныеИмущественногоКомплекса - Структура - содержит основные данные объекта, 
//			см. УН_ИмущественныйКомплексСервисВызовСервера.НовыйСтруктураИмущественныйКомплекс().
// 
Процедура СоздатьИмущественныйКомплекс(ОсновныеДанныеИмущественногоКомплекса) Экспорт
// Предпосылки	
	Если ОсновныеДанныеИмущественногоКомплекса = Неопределено Тогда
		УН_ИсключенияВызовСервера.ВызватьИсключениеЗначениеНеопределено(ОсновныеДанныеИмущественногоКомплекса);
	КонецЕсли;
	
	Если ТипЗнч(ОсновныеДанныеИмущественногоКомплекса) <> Тип("Структура") Тогда
		УН_ИсключенияВызовСервера.ВызватьИсключениеНедопустимыйТип("ОсновныеДанныеИмущественногоКомплекса");
	КонецЕсли;
		
	Если НЕ ОсновныеДанныеИмущественногоКомплекса.Свойство("Организация") Тогда
		УН_ИсключенияВызовСервера.ВызватьИсключениеСвойствоНеСуществует("Организация", 
			"ОсновныеДанныеИмущественногоКомплекса");
	КонецЕсли;
	
	Если НЕ ОсновныеДанныеИмущественногоКомплекса.Свойство("ТипИмущественногоКомплекса") Тогда
		УН_ИсключенияВызовСервера.ВызватьИсключениеСвойствоНеСуществует("ТипИмущественногоКомплекса", 
			"ОсновныеДанныеИмущественногоКомплекса");
	КонецЕсли;
	
	Если НЕ ОсновныеДанныеИмущественногоКомплекса.Свойство("ГруппаПолномочий") Тогда
		УН_ИсключенияВызовСервера.ВызватьИсключениеСвойствоНеСуществует("ГруппаПолномочий", 
			"ОсновныеДанныеИмущественногоКомплекса");
	КонецЕсли;

// Основная часть	
	Если ЗначениеЗаполнено(ОсновныеДанныеИмущественногоКомплекса.Организация)
		И ЗначениеЗаполнено(ОсновныеДанныеИмущественногоКомплекса.ТипИмущественногоКомплекса)
		И ЗначениеЗаполнено(ОсновныеДанныеИмущественногоКомплекса.ГруппаПолномочий) Тогда

		СоздатьИмущественныйКомплексСлужебный(ОсновныеДанныеИмущественногоКомплекса);
	Иначе
		// Вызов диалога для заполнения обязательных полей (нужны для выбора формы и проверки полномочий перед созданием)
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьСозданиеИмущественногоКомплекса", ЭтотОбъект);
	
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("ОсновныеДанные", ОсновныеДанныеИмущественногоКомплекса);
		
		ОткрытьФорму("ОбщаяФорма.УН_СоздатьИмущественныйКомплекс",
			ПараметрыФОрмы,
			ЭтотОбъект,,,,
			ОписаниеОповещения, 
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);		
	КонецЕсли;
КонецПроцедуры



