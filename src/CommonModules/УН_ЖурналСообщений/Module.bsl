// Возвращает текст запроса для Сообщений журналов
Функция НовыйТекстЗапросаСообщения()
	Результат = "ВЫБРАТЬ
	            |	УН_СообщенияЖурнала.КлючЖурналаСообщений КАК КлючЖурналаСообщений,
	            |	УН_СообщенияЖурнала.ВнутреннийНомерСообщения КАК ВнутреннийНомерСообщения,
	            |	УН_СообщенияЖурнала.КодПредметнойОбласти КАК КодПредметнойОбласти,
	            |	УН_СообщенияЖурнала.НомерСообщения КАК НомерСообщения,
	            |	УН_СообщенияЖурнала.ТипСообщения КАК ТипСообщения,
	            |	УН_СообщенияЖурнала.ТекстСообщения КАК ТекстСообщения,
	            |	УН_СообщенияЖурнала.Параметр1 КАК Параметр1,
	            |	УН_СообщенияЖурнала.Параметр2 КАК Параметр2,
	            |	УН_СообщенияЖурнала.Параметр3 КАК Параметр3,
	            |	УН_СообщенияЖурнала.Параметр4 КАК Параметр4,
	            |	УН_СообщенияЖурнала.Родитель КАК Родитель,
	            |	УН_СообщенияЖурнала.Контекст КАК Контекст,
	            |	УН_СообщенияЖурнала.СообщениеСсылка КАК СообщениеСсылка,
	            |	УН_ШаблоныСообщений.ЕстьДопТекст КАК ЕстьДопТекст
	            |ИЗ
	            |	РегистрСведений.УН_СообщенияЖурнала КАК УН_СообщенияЖурнала
	            |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УН_ШаблоныСообщений КАК УН_ШаблоныСообщений
	            |		ПО УН_СообщенияЖурнала.СообщениеСсылка = УН_ШаблоныСообщений.Ссылка
	            |[&ГДЕ]
				|
	            |УПОРЯДОЧИТЬ ПО
	            |	КлючЖурналаСообщений,
	            |	ВнутреннийНомерСообщения";	
	Возврат Результат;	         
КонецФункции

// Модифицирует текст запроса для полкучения Сообщений журналов на основании ключей журнала сообщений.
//
// Параметры:
//  ТекстЗапроса 	 	 - Строка - исходный текст запроса
//  КлючЖурналаСообщений - Структура - см.  ЗаполнитьЗаголовки()
//  ПараметрыЗапроса 	 - Структура - содержит элементы в формате ИмяПараметра - Значение, если параметр КлючЖурналаСообщений не пустой 
//		ИмяПараметра 		- содержит имя параметра в тексте запроса
//		Значение	 		- содержит значение соответсвующего параметра запроса из параметра Отбор
Процедура МодифицироватьТекстЗапросаСообщения(ТекстЗапроса, Знач КлючЖурналаСообщений, ПараметрыЗапроса)
// Предпосылки	
	Если ЗначениеЗаполнено(ТекстЗапроса) = Ложь Тогда
		УН_ИсключенияВызовСервера.ВызватьИсключениеПустоеЗначение("ТекстЗапроса");
	КонецЕсли;	
	
// Основная часть
	ТекстГДЕ = Новый Массив;

	ОбработатьПараметрКлючЖурналаСообщений(КлючЖурналаСообщений, ПараметрыЗапроса, ТекстГДЕ);

	// корректируем предложение ГДЕ в тексте запроса	
	Если ЗначениеЗаполнено(ТекстГДЕ) Тогда
		ВыражениеГДЕ = СтрСоединить(ТекстГДЕ, " И "); 
		ВыражениеГДЕ = СтрШаблон("ГДЕ %1", ВыражениеГДЕ); 
		
		ТекстЗапроса = СтрЗаменить(
			ТекстЗапроса,
			"[&ГДЕ]",
			ВыражениеГДЕ);
	Иначе
		ТекстЗапроса = СтрЗаменить(
			ТекстЗапроса,
			"[&ГДЕ]",
			"");			
	КонецЕсли;
КонецПроцедуры

// Проверяет наличие критерия отбора и при необхдимости корректирует текст запроса 
// и заполняет структуру ПараметрыЗапроса
//
// Параметры:
//  КлючЖурналаСообщений - Структура - см.  ЗаполнитьЗаголовки()
//  ПараметрыЗапроса 	 - Структура - содержащая элементы в формате ИмяПараметра - Значение
//		ИмяПараметра 	 - содержит имя параметра в тексте запроса
//		Значение	 	 - содержит значение соответсвующего параметра запроса из параметра Отбор
//  ЗапросГДЕ		 	 - Массив - содержит список элементов, которые долнжны участвовать в предложении ГДЕ текста запроса. 
//								При необходимости добавляет в массив новый элемент.       
Процедура ОбработатьПараметрКлючЖурналаСообщений(Знач КлючЖурналаСообщений, ПараметрыЗапроса, ЗапросГДЕ)
// Предпосылки	 
    ИмяПараметра 	  = "КлючЖурналаСообщений";
	ЗначениеПараметра = КлючЖурналаСообщений;
	
	Если ЗначениеПараметра = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(ЗапросГДЕ) <> Тип("Массив") Тогда 
		УН_ИсключенияВызовСервера.ВызватьИсключениеНедопустимыйТип("ЗапросГДЕ");	
	КонецЕсли;
	
	ТекстГДЕ 		  = "";
	ЛеваяЧасть		  = "УН_СообщенияЖурнала.КлючЖурналаСообщений";
	ПраваяЧасть		  = ИмяПараметра;
	ОператорСравнения = "="; 
	НедопустимыйТип	  = Истина;
		
	// тип параметра - массив => анализируем только первый элемент 
	Если ТипЗнч(ЗначениеПараметра) = Тип("Массив") Тогда  
		НедопустимыйТип	= Ложь;	
		
		Для каждого ЭлементМассива из КлючЖурналаСообщений Цикл
			ОператорСравнения = "В";
			ЗначениеПараметра = ЭлементМассива;
			Прервать;
		КонецЦикла;
	КонецЕсли;
		
	// тип параметра - УникальныйИдентификатор
	Если ТипЗнч(ЗначениеПараметра) = Тип("УникальныйИдентификатор") Тогда
		НедопустимыйТип	= Ложь;						
	КонецЕсли;
	
	Если НедопустимыйТип Тогда
		Возврат;
	КонецЕсли;	
	
	ТекстГДЕ = СтрШаблон("%1 %2 &%3", 
		ЛеваяЧасть,
		ОператорСравнения,
		ПраваяЧасть);	
	
	ПараметрыЗапроса.Вставить(ИмяПараметра,КлючЖурналаСообщений);
	
	Если ЗначениеЗаполнено(ТекстГДЕ) Тогда
		ЗапросГДЕ.Добавить(ТекстГДЕ);
	КонецЕсли;
КонецПроцедуры
