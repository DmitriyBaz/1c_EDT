// Возвращает объект - Менеджер измерений 
Функция МенеджерИзмерений(Объект) Экспорт;
	Результат = Неопределено;
	
	// Получить список с потомками
	Попытка
		СвойстваОбъекта = Объект.ДополнительныеСвойства;
		Потомки = СвойстваОбъекта.Потомки;
	Исключение
		// Обработка ошибок
		Сообщить("Невозможно получить значение свойства ""Потомки""");  
		Возврат Неопределено;
	КонецПопытки; 
	
	// Ищем в Потомках
	МенеджерИзмерений = Потомки.Получить("УН_Измерения");
	
	// Менеджер измерений не зарегистрирован => создадим.   
	Если МенеджерИзмерений = Неопределено Тогда
		
		МенеджерИзмерений = УН_МенеджерИзмеренийФабрика.Создать(Объект);	
	
		// добавим созданный объект в список потомков
		ЗарегистрироватьПотомка(Объект, "УН_Измерения", МенеджерИзмерений); 
	КонецЕсли;	                                                    
	
	Результат = МенеджерИзмерений;
	Возврат Результат;
КонецФункции

