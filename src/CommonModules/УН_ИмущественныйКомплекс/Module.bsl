	РежимПросмотр = Перечисления.УН_РежимОбъекта.Просмотр;	
	
	// Выполнить проверки перед сохранением
	
	
	// Если ошибок не возникло - сохраняем.
	Попытка
		Если Объект.Модифицированность() Тогда
			Объект.Записать();
			// меняем режим на "просмотр"
			Объект.ДополнительныеСвойства.Режим = РежимПросмотр;
		КонецЕсли;		
	Исключение
		// Обработка ошибок
		Сообщить("Возникла ошибка при сохранении объекта ""Имущественный комплекс""");  
	КонецПопытки; 	
