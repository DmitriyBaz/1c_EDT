#Область ПрограммныйИнтерфейс 
 
// Возвращает структуру для настройки реестра с начальными значениями.
//
// Возвращаемое значение:
//   Структура - новая настройка с начальными значениями
//		КлючЗаписи 					- УникальныйИдентификатор - уникальный идентификактор настройки
//		ВышестоящийУзел				- УникальныйИдентификатор - ссылка вышестоящую запись
//		Порядок 					- Число - порядковый номер записи настройки среди других настроек 
//		Наименование 				- Строка - наименование настройки
//		Описание 					- Строка - описание настройки
//		ПутьКФорме 					- Строка - полное имя формы с настройкой
//		ЭтоГруппа 					- Булево - признак того, что запись является Группой. Группа не является настройкой,
//									  может содержать другие Группы и настройки. 
//		Автор 						- СправочникСсылка.Пользователи - пользователь, создавший настройку
//		ДатаВремяСозданияUTC 		- ДатаВремя - дата и время создания настройки в UTC
//		ДатаВремяСозданияМестное 	- ДатаВремя - дата и время создания настройки (местное время)
//		ПоследнимИзменил			- СправочникСсылка.Пользователи - пользователь, последний изменивший настройку	
//		ДатаВремяИзмененияUTC 		- ДатаВремя - дата и время изменения настройки в UTC	
//		ДатаВремяИзмененияМестное 	- ДатаВремя - дата и время изменения настройки (местное время)
//		Документация				- ФорматированныйДокумент - документация к настройке
//		ЕстьДокументация 			- Булево - признак наличия документации к настройке					
Функция НоваяНастройка() Экспорт;
	НоваяНастройка = Новый Структура;
	НоваяНастройка.Вставить("КлючЗаписи", Неопределено);
	НоваяНастройка.Вставить("ВышестоящийУзел", Неопределено);
	НоваяНастройка.Вставить("Порядок", 0);
	НоваяНастройка.Вставить("Наименование", "");
	НоваяНастройка.Вставить("Описание", "");
	НоваяНастройка.Вставить("ПутьКФорме", "");
	НоваяНастройка.Вставить("ЭтоГруппа", Ложь);

	// сегмент данных пользователя	
	НоваяНастройка.Вставить("Автор");
	НоваяНастройка.Вставить("ДатаВремяСозданияUTC");
	НоваяНастройка.Вставить("ДатаВремяСозданияМестное");
	НоваяНастройка.Вставить("ПоследнимИзменил");
	НоваяНастройка.Вставить("ДатаВремяИзмененияUTC");
	НоваяНастройка.Вставить("ДатаВремяИзмененияМестное");
	
	// сегмент данных документация
	НоваяНастройка.Вставить("Документация", Неопределено);
	НоваяНастройка.Вставить("ЕстьДокументация", Ложь);	
	Возврат НоваяНастройка;
КонецФункции

// Проверяет, содержит ли форматированный документ элементы.
//
// Параметры:
//   ФорматированныйДокумент - ФорматированныйДокумент - документ для проверки наличия элементов
//
// Возвращаемое значение:
//   Булево - Истина, если документ содержит элементы, Ложь иначе
Функция ЕстьДокументация(Знач ФорматированныйДокумент) Экспорт;
	Если ФорматированныйДокумент = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	Если ТипЗнч(ФорматированныйДокумент) <> Тип("ФорматированныйДокумент") Тогда
		УН_ИсключенияВызовСервера.ВызватьИсключениеНедопустимыйТип("ФорматированныйДокумент");
	КонецЕсли;
	
	Возврат ФорматированныйДокумент.ПолучитьЭлементы().Количество() > 0;
КонецФункции

#КонецОбласти