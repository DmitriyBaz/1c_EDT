////////////////////////////////////////////////////////////////////////////////
// Цвет Сервис
// 
// Реализует методы для работы с цветом (серверные)
////////////////////////////////////////////////////////////////////////////////  


#Область ПрограммныйИнтерфейс 
// Преобразует строку с шестнадцатеричным цветом в объект Цвет.
// Поддерживаются форматы: 0xRRGGBB, #RRGGBB, RRGGBB.
// В случае ошибки возвращает Черный цвет.
//
// Параметры:
//  Цвет_HEX - Строка - Строка с hex-кодом цвета.
//
// Возвращаемое значение:
//  Цвет - Объект типа Цвет.
//
Функция HEX_в_RGB(Знач Цвет_HEX) Экспорт

    // Приводим строку к верхнему регистру для удобства обработки и удаляем возможные префиксы.
    СтрокаЦвета = ВРег(СокрЛП(Цвет_HEX));
    СтрокаЦвета = СтрЗаменить(СтрокаЦвета, "0X", "");
    СтрокаЦвета = СтрЗаменить(СтрокаЦвета, "#", "");

    // Проверяем базовые критерии валидности: непустая строка и допустимая длина.
    // Корректная строка после очистки должна иметь длину 6 символов (RRGGBB).
    Если ПустаяСтрока(СтрокаЦвета) ИЛИ СтрДлина(СтрокаЦвета) <> 6 Тогда
        Возврат WebЦвета.Черный;
    КонецЕсли;

    // Основная логика преобразования в блоке попытки.
    Попытка
        Красный   = ЧислоИзШестнадцатеричнойСтроки("0x" + Сред(СтрокаЦвета, 1, 2));
        Зеленый = ЧислоИзШестнадцатеричнойСтроки("0x" + Сред(СтрокаЦвета, 3, 2));
        Синий    = ЧислоИзШестнадцатеричнойСтроки("0x" + Сред(СтрокаЦвета, 5, 2));

        Возврат Новый Цвет(Красный, Зеленый, Синий);

    Исключение
        // Если на любом этапе преобразования возникла ошибка (например, неhex-символ),
        // возвращаем цвет по умолчанию.
        Возврат WebЦвета.Черный;
    КонецПопытки;

КонецФункции
#КонецОбласти