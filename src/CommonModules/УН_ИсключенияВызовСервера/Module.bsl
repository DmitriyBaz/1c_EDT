	Категория 		= КатегорияОшибки.ОшибкаКонфигурации;	
    Код				= "D-0001_005";
	ВызватьИсключение(ТекстИсключения, Категория, Код);	
КонецПроцедуры

// Исключение D-0001_006 Не удалось установить блокировку.
//
// Параметры:
//   ОбъектБлокировки - Строка - Имя объекта блокировки (полное имя объекта метаданных, например, "РегистСведений.УН_ТекущиеНомераОбъектовНумерации") 
//   ПоляБлокировки   - Массив - Каждый элемент массива содержит структуру, где Ключ соответсвует имени поля блокировки, 
//						а Значение - значению, по которому выполняется блокировка. 
Процедура ВызватьИсключениеБлокировкаНеУстановлена(Знач ОбъектБлокировки, Знач ПоляБлокировки = Неопределено) Экспорт
	ТекстИсключения = НСтр("ru = 'Не удалось установить блокировку.';  
		|en = 'The lock could not be set.'");
	
	ШаблонТекстаДляОбъекта = НСтр("ru = 'Объект блокировки: ""%1"".';  
		|en = 'Object: ""%1"".'");
	ТекстДляОбъекта = СтрШаблон(ШаблонТекстаДляОбъекта, ОбъектБлокировки); 
    ТекстИсключения = ТекстИсключения + Символы.ПС + ТекстДляОбъекта; 
	
	ШаблонТекстаДляПоляБлокировки = НСтр("ru = 'Поле блокировки ""%1"": ""%2"".';  
		|en = 'Field: ""%1"": ""%2"".'");

	Если ПоляБлокировки <> Неопределено Тогда  
		Если ТипЗнч(ПоляБлокировки) = Тип("Массив") Тогда
			Для каждого ПолеБлокировки из ПоляБлокировки Цикл
				Если ТипЗнч(ПолеБлокировки) <> Тип("Структура") Тогда
					Продолжить;
				КонецЕсли;
				
				Если НЕ ПолеБлокировки.Свойство("ИмяПоля") 
					ИЛИ НЕ ПолеБлокировки.Свойство("ЗначениеПоля") Тогда
					Продолжить;
				КонецЕсли;
				
				ТекстИсключения = ТекстИсключения + Символы.ПС + 
					СтрШаблон(ШаблонТекстаДляПоляБлокировки, ПолеБлокировки.ИмяПоля, ПолеБлокировки.ЗначениеПоля);
				
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Категория 		= КатегорияОшибки.ОшибкаКонфигурации;	
    Код				= "D-0001_006";
	ВызватьИсключение(ТекстИсключения, Категория, Код);	
КонецПроцедуры
#КонецОбласти



#Область УправлениеДоступом
// Исключение D-0002_001 Нет полномочий на операцию %1 для %2
//
// Параметры:
//   Право 			- Строка - Имя права доступа ("добавление", "чтение", и т.д., см. названия прав)
//	 ОбъектДоступа	- Строка - Имя объекта доступа (полное имя объекта метаданных)
Процедура ВызватьИсключениеНетПраваДоступа(Знач Право, Знач ОбъектДоступа) Экспорт
	ШаблонТекста = НСтр("ru = 'Нет полномочий на операцию ""%1"" для ""%2"".';  
		|en = 'Activity ""%1"" is not allowed for ""%2"".'");
	ТекстИсключения = СтрШаблон(ШаблонТекста, Право, ОбъектДоступа);
	Категория 		= КатегорияОшибки.НарушениеПравДоступа;	
    Код				= "D-0002_001";
	ВызватьИсключение(ТекстИсключения, Категория, Код);	
КонецПроцедуры

// Исключение D-0002_002 Нет полномочий на операцию %1 для %2 для значений проверяемых полей %3
//
// Параметры:
//   Право 			- Строка - Имя права доступа ("добавление", "чтение", и т.д., см. названия прав)
//	 ОбъектДоступа	- Строка - Имя объекта доступа (полное имя объекта метаданных)
//	 ВидыДоступа	- Массив - Каждый элемент массива содержит структуру, где Ключ соответсвует синониму поля объекта, 
//						а Значение - значению для соответствующего Вида доступа. 
// 
Процедура ВызватьИсключениеНетПраваДоступаДляВидовДоступа(Знач Право, Знач ОбъектДоступа, Знач ВидыДоступа) Экспорт
	ШаблонТекста = НСтр("ru = 'Нет полномочий на операцию ""%1"" для ""%2"" по значениям проверяемых полей:';  
		|en = 'Activity ""%1"" is not allowed for ""%2"" arrording to:'");
	
	ШаблонТекстаДляВидаДоступа = "- %1: ""%2""";
	
	ТекстИсключения = СтрШаблон(ШаблонТекста, Право, ОбъектДоступа);
	
	Если ТипЗнч(ВидыДоступа) = Тип("Массив") Тогда
		КоличествоВидовДоступа = ВидыДоступа.Количество();
		Счетчик = 1;
		Для каждого ВидДоступа из ВидыДоступа Цикл
			Если ТипЗнч(ВидДоступа) <> Тип("Структура") Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ ВидДоступа.Свойство("ИмяПоля") 
				ИЛИ НЕ ВидДоступа.Свойство("ЗначениеПоля") Тогда
				Продолжить;
			КонецЕсли;
				
			ТекстИсключения = ТекстИсключения + Символы.ПС + 
				СтрШаблон(ШаблонТекстаДляВидаДоступа, ВидДоступа.ИмяПоля, ВидДоступа.ЗначениеПоля);
				
			Если Счетчик < КоличествоВидовДоступа Тогда
				ТекстИсключения = ТекстИсключения + ";";
			Иначе
				ТекстИсключения = ТекстИсключения + ".";
			КонецЕсли;
			Счетчик = Счетчик + 1;
		КонецЦикла;
	КонецЕсли;			
	
	Категория 		= КатегорияОшибки.НарушениеПравДоступа;	
    Код				= "D-0002_002";
    
	ВызватьИсключение(ТекстИсключения, Категория, Код);	
КонецПроцедуры  
#КонецОбласти


