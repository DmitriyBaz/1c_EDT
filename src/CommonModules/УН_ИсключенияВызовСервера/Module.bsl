#Область ПрограммныйИнтерфейс  


#Область Общие
// Исключение D-0001_001 Параметр %1 имеет недопустимый тип .
//
// Параметры:
//   ИмяПараметра - Строка - имя параметра, вызвавшего исключение
Процедура ВызватьИсключениеНедопустимыйТип(Знач ИмяПараметра) Экспорт;
	ШаблонТекста = НСтр("ru = 'Параметр %1 имеет недопустимый тип.'; 
		|en = 'Рarameter %1 has an invalid type'");
	
	ТекстИсключения = СтрШаблон(ШаблонТекста,ИмяПараметра);
	Категория 		= КатегорияОшибки.ОшибкаКонфигурации;
	Код				= "D-0001_001";
	ВызватьИсключение(ТекстИсключения, Категория, Код); 
КонецПроцедуры 

// Исключение D-0001_002 Запись с кодом %1 не существует в %2
//
// Параметры:
//   КлючЗаписи - Строка - Код записи, которая должна быть проверена на существование
//   ИмяИсточника - Строка - Наименование источника, в котором проверяется существование записи
Процедура ВызватьИсключениеЗаписьНеСуществует(Знач КлючЗаписи, Знач ИмяИсточника) Экспорт
	ШаблонТекста = НСтр("ru = 'Запись с кодом %1 не существует в %2.'; 
		|en = 'The entry with the %1 code does not exist in %2'");
	
	ТекстИсключения = СтрШаблон(
		ШаблонТекста, 
		КлючЗаписи, 
		ИмяИсточника);
	Категория = КатегорияОшибки.ОшибкаКонфигурации;
    Код	= "D-0001_002";	
	ВызватьИсключение(ТекстИсключения, Категория, Код);
КонецПроцедуры


