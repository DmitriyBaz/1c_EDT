// Исключение D-0003_006 Номер %1 не уникальный.
//
// Параметры:
//   Номер - Строка - Значение номера 
//   КлючиУникальности - Массив - Каждый элемент массива содержит структуру, где Ключ соответсвует имени поля (измерение регистра УН_НомераОбъектовНумерации), 
//						а Значение - значению, по которому выполняется проверка. 
Процедура ВызватьИсключениеНомерНеУникальный(Знач Номер, Знач КлючиУникальности) Экспорт 
	ШаблонТекста = НСтр("ru = 'Номер ""%1"" не уникальный.';  
		|en = 'The number ""%1"" is not unique.'");
	
	ТекстИсключения = СтрШаблон(ШаблонТекста, Номер);
	
	ШаблонТекстаДляПоляУникальности = НСтр("ru = 'Ключ уникальности ""%1"": ""%2"".';  
		|en = 'Key ""%1"": ""%2"".'");

	Если КлючиУникальности <> Неопределено Тогда  
		Если ТипЗнч(КлючиУникальности) = Тип("Массив") Тогда
			Для каждого КлючУникальности из КлючиУникальности Цикл
				Если ТипЗнч(КлючУникальности) <> Тип("Структура") Тогда
					Продолжить;
				КонецЕсли;
				
				Если НЕ КлючУникальности.Свойство("ИмяПоля") 
					ИЛИ НЕ КлючУникальности.Свойство("ЗначениеПоля") Тогда
					Продолжить;
				КонецЕсли;
				
				ТекстИсключения = ТекстИсключения + Символы.ПС + 
					СтрШаблон(ШаблонТекстаДляПоляУникальности, КлючУникальности.ИмяПоля, КлючУникальности.ЗначениеПоля);		
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Категория 		= КатегорияОшибки.ОшибкаКонфигурации;	
    Код				= "D-0003_006";
	ВызватьИсключение(ТекстИсключения, Категория, Код);	
КонецПроцедуры

// Исключение D-0003_007 Объект нумерации %1: ДиапазонНомеров %2: Превышена допустимая длина номера.
//
// Параметры:
//   ОбъектНумерацииКод - Строка - Идентификатор Объекта нумерации (Справочники.УН_ОбъектыНумерации.Код)
//	 ДиапазонНомеров - Строка - Диапазон номеров (РегистрСведений.УН_ДиапазоныНомеров.НомерДиапазона)
//	 Номер - Строка - Значение номера
//	 ДлинаНомера - Число - Допустимая длина номера согласно настройке
Процедура ВызватьИсключениеПревышенаДлинаНомера(Знач ОбъектНумерацииКод, Знач ДиапазонНомеров, Знач Номер, Знач ДлинаНомера) Экспорт
	ШаблонТекста = НСтр("ru = 'Объект нумерации ""%1"": Диапазон номеров ""%2"": Длина номера ""%3"" с префиксом превышает допустимую длину %4 символов.';  
		|en = 'Object ""%1"": Range ""%2"": The length of ""%3"" including the prefix is too long. Only %4 characters permitted .'");
	
	ТекстИсключения = СтрШаблон(ШаблонТекста, ОбъектНумерацииКод, ДиапазонНомеров, Номер, ДлинаНомера);
	Категория 		= КатегорияОшибки.ОшибкаКонфигурации;	
    Код				= "D-0003_007";  
	ДополнительнаяИнформация = НСтр("ru = 'Проверьте настройки Объектов нумерации и Диапазона номеров. 
		|Длина номера с префиксом не должна превышать установленной максимальной длины.'; 
		|en = 'Check the settings of the Numbering Objects and the Number Range.
		|The length of the number with the prefix must not exceed the set maximum length.'");
	ВызватьИсключение(ТекстИсключения, Категория, Код, ДополнительнаяИнформация);	
КонецПроцедуры 
