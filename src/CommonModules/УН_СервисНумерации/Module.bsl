// Выполняет проверку номера. При наличии ошибок вызывает исключение
Процедура ПроверитьНомерСлужебный(ОбъектНумерации, Подобъект = "", Диапазон, ПериодУникальности, Номер, ПараметрыНумерации) Экспорт;
// Предпосылки
	Если Номер = Неопределено Тогда
		УН_ИсключенияВызовСервера.ВызватьИсключениеЗначениеНеопределено("Номер");
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Номер) = Неопределено Тогда
		УН_ИсключенияВызовСервера.ВызватьИсключениеПустоеЗначение("Номер");
	КонецЕсли;	
	
	Если ПараметрыНумерации = Неопределено Тогда
		УН_ИсключенияВызовСервера.ВызватьИсключениеЗначениеНеопределено("ПараметрыНумерации");
	КонецЕсли;
	
	Если ТипЗнч(ПараметрыНумерации) <> Тип("Структура") Тогда
		УН_ИсключенияВызовСервера.ВызватьИсключениеНедопустимыйТип("ПараметрыНумерации");
	КонецЕсли; 
	
	Если НЕ ПараметрыНумерации.Свойство("ПериодичностьНомера") Тогда
		УН_ИсключенияВызовСервера.ВызватьИсключениеСвойствоНеСуществует("ПериодичностьНомера", "ПараметрыНумерации");
	КонецЕсли; 

	Если НЕ ПараметрыНумерации.Свойство("Автонумерация") Тогда
		УН_ИсключенияВызовСервера.ВызватьИсключениеСвойствоНеСуществует("Автонумерация", "ПараметрыНумерации");
	КонецЕсли;

	Если НЕ ПараметрыНумерации.Свойство("ДлинаНомера") Тогда
		УН_ИсключенияВызовСервера.ВызватьИсключениеСвойствоНеСуществует("ДлинаНомера", "ПараметрыНумерации");
	КонецЕсли;
	
	Если НЕ ПараметрыНумерации.Свойство("ИспользоватьПрефикс") Тогда
		УН_ИсключенияВызовСервера.ВызватьИсключениеСвойствоНеСуществует("ИспользоватьПрефикс", "ПараметрыНумерации");
	КонецЕсли;	
	
	Если НЕ ПараметрыНумерации.Свойство("Префикс") Тогда
		УН_ИсключенияВызовСервера.ВызватьИсключениеСвойствоНеСуществует("Префикс", "ПараметрыНумерации");
	КонецЕсли;		

// Основная часть
	// Выход за верхнюю границу диапазона
	Если ПараметрыНумерации.Автонумерация Тогда 
		Если Число(Номер) > ПараметрыНумерации.КонечноеЗначение Тогда
			УН_ИсключенияВызовСервера.ВызватьИсключениеДиапазонНомеровДостигнутКонечныйНомер(ОбъектНумерации.Код, Диапазон); 
		КонецЕсли;  
	КонецЕсли;
	
	// Длина номера в символах
	ОбщаяДлинаНомера = ПараметрыНумерации.ДлинаНомера;	
    Префикс = "";
	Если ПараметрыНумерации.ИспользоватьПрефикс Тогда
		Префикс = ПараметрыНумерации.Префикс;		
	КонецЕсли;
	
	НомерСтрокой = Префикс + Строка(Номер); 
	Если СтрДлина(НомерСтрокой) > ОбщаяДлинаНомера Тогда
		УН_ИсключенияВызовСервера.ВызватьИсключениеПревышенаДлинаНомера(ОбъектНумерации.Код, Диапазон, НомерСтрокой, ОбщаяДлинаНомера) 	
	КонецЕсли;
	
	// Уникальность номера
	НомерУникальный = ПроверитьУникальностьНомера(ОбъектНумерации, Подобъект, Диапазон, ПериодУникальности, Номер); 
	Если НЕ НомерУникальный Тогда
		КлючиУникальности = Новый Массив();
		КлючиУникальности.Добавить(Новый Структура("ИмяПоля, ЗначениеПоля", 
			"ОбъектНумерации", Строка(ОбъектНумерации.Код)));
		КлючиУникальности.Добавить(Новый Структура("ИмяПоля, ЗначениеПоля", 
			"Подобъект", Строка(Подобъект)));
		КлючиУникальности.Добавить(Новый Структура("ИмяПоля, ЗначениеПоля", 
			"Диапазон", Строка(Диапазон)));
		КлючиУникальности.Добавить(Новый Структура("ИмяПоля, ЗначениеПоля", 
			"ПериодУникальности", Строка(ПериодУникальности)));
		
		УН_ИсключенияВызовСервера.ВызватьИсключениеНомерНеУникальный(Номер, КлючиУникальности); 
	КонецЕсли;
КонецПроцедуры


#КонецОбласти